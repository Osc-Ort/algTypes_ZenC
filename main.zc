import "priority_queue.zc"

fn main() {
    // minheap
    let q = priority_queue<i32>::new(true);
    let limit = 10;
    for i in 1..=limit {
        q.push(i**2);
    }
    "Los cuadrados de los numeros del 1 al {limit}:";
    while !q.is_empty() {
        "{q.top()} "..;
        q.pop();
    }
    ""
}